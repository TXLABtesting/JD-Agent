# ── MOCA JD Agent — AI provider configuration ────────────────────────────────
# The app defaults to the deterministic `local` provider (no network, no keys),
# so copying this file is only needed to connect a real model provider.
#
# Provider: local | claude | openai | gemini
VITE_AI_PROVIDER=local

# Optional model id override (defaults per provider: claude-opus-4-8, gpt-4o, gemini-2.5-flash)
# VITE_AI_MODEL=claude-opus-4-8

# Reasoning effort (Claude): low | medium | high | xhigh | max
# VITE_AI_EFFORT=high

# API keys (only for the selected provider). NOTE: in a browser build these are
# exposed to the client — for production, route calls through a backend/proxy
# (VITE_AI_BASE_URL) and keep keys server-side.
# VITE_ANTHROPIC_API_KEY=
# VITE_OPENAI_API_KEY=
# VITE_GEMINI_API_KEY=

# Optional base-url override: a proxy, Azure OpenAI endpoint, or local LLM server
# VITE_AI_BASE_URL=
